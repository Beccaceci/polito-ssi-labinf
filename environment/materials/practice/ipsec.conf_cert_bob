# Practice replacement; explicit IKEv2 transport configuration.
config setup
 uniqueids=yes
conn host2-host2
 keyexchange=ikev2
 type=transport
 left=@LOCAL_IP@
 right=@REMOTE_IP@
 leftsubnet=@LOCAL_IP@/32
 rightsubnet=@REMOTE_IP@/32
 ike=aes128-sha256-modp2048!
 esp=aes128-sha256!
 auto=add
 leftauth=pubkey
 rightauth=pubkey
 leftcert=identity.crt
 leftid="C=IT, O=Polito, CN=@LOCAL_CN@"
 rightid="C=IT, O=Polito, CN=@REMOTE_CN@"
