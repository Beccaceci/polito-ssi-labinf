# Pin the multi-architecture manifest so a rebuild starts from the same Kali
# base. Refresh this digest intentionally when updating the lab toolchain.
FROM kalilinux/kali-rolling:latest@sha256:02f5d6c019e549b0f55da58e835cad5355ef1030c6b2645265a324e37dfc4acc

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core Network & Pentesting Tools
    ettercap-text-only \
    nmap \
    iproute2 \
    net-tools \
    iputils-ping \
    curl \
    wget \
    dsniff \
    tcpdump \
    tshark \
    lynx \
    s-nail \
    dnsutils \
    netcat-openbsd \
    ftp \
    sshpass \
    procps \
    nano \
    sudo \
    python3 \
    # Lab 02 & 03: Crypto & Digest Tools
    openssl \
    hashdeep \
    hexedit \
    p7zip-full \
    # Lab 04: Firewall & Netfilter Tools
    iptables \
    iptables-persistent \
    nftables \
    conntrack \
    ulogd2 \
    # Lab 05: IPsec & Tunneling Tools
    strongswan \
    strongswan-swanctl \
    libstrongswan-extra-plugins \
    ptunnel \
    httptunnel \
    # Web GUI & Desktop Tools (Optional on-demand access on port 6080)
    tigervnc-standalone-server \
    novnc \
    websockify \
    openbox \
    xterm \
    wireshark \
    && rm -rf /var/lib/apt/lists/*

# Keep this addition separate so the larger toolchain layer remains reusable.
RUN apt-get update && apt-get install -y --no-install-recommends ethtool \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -G sudo,wireshark kali && \
    echo "kali:kali" | chpasswd && \
    echo "kali ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN apt-get update && apt-get install -y --no-install-recommends openssh-client && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/labinf-ettercap /usr/local/bin/labinf-ettercap
COPY scripts/labinf-node-init.sh /usr/local/bin/labinf-node-init.sh
RUN chmod 0755 /usr/local/bin/labinf-ettercap /usr/local/bin/labinf-node-init.sh

# Complete exercise tools; resolve the resulting toolchain into each run inventory.
RUN apt-get update && apt-get install -y --no-install-recommends \
    supervisor apache2 apache2-utils openssh-server strongswan-starter strongswan-charon python3-venv \
    libcharon-extra-plugins openssl-provider-legacy perl python3-cryptography \
    python3-pycryptodome python3-flask time file xxd man-db manpages less \
    firefox-esr x11-xserver-utils xauth xdotool dnsmasq-base \
    && rm -rf /var/lib/apt/lists/*
COPY vendor/CA.pl.in /tmp/CA.pl.in
RUN mkdir -p /usr/lib/ssl/misc && \
    sed '1c#!/usr/bin/perl' /tmp/CA.pl.in > /usr/lib/ssl/misc/CA.pl && \
    chmod 0755 /usr/lib/ssl/misc/CA.pl && rm /tmp/CA.pl.in && \
    ln -sf /usr/lib/ssl/misc/CA.pl /usr/local/bin/CA.pl
RUN python3 -m venv --system-site-packages /opt/labinf/venv && /opt/labinf/venv/bin/pip install --no-cache-dir pycryptodome==3.23.0
ENV PATH=/opt/labinf/venv/bin:$PATH
COPY scripts/labinf-apache scripts/labinf-service scripts/labinf-exercise-init scripts/labinf-gui scripts/labinf-browser /usr/local/bin/
COPY scripts/labinf-supervisor.conf /etc/supervisor/labinf.conf
COPY materials /opt/labinf/materials
COPY verification /opt/labinf/verification
RUN chmod 0755 /usr/local/bin/labinf-* /opt/labinf/materials/practice/*.py /opt/labinf/materials/practice/*.sh && \
    useradd -m -s /bin/bash ali && echo 'ali:ali' | chpasswd && \
    echo 'kali:kali' | chpasswd && \
    mkdir -p /home/kali/.labinf-firefox /workspace /exchange && \
    chown -R kali:kali /home/kali /workspace /exchange && \
    printf '\nPasswordAuthentication yes\nPermitRootLogin prohibit-password\n' >> /etc/ssh/sshd_config && \
    dpkg-query -W > /opt/labinf/packages.txt
# Keep the CA configuration intact; add providers without lowering TLS security.
RUN python3 - <<'PYCONF'
from pathlib import Path
p = Path('/etc/ssl/openssl.cnf')
s = p.read_text().replace('openssl_conf = openssl_init', 'openssl_conf = labinf_init')
s += "\n[labinf_init]\nproviders = labinf_providers\n[labinf_providers]\ndefault = labinf_default\nlegacy = labinf_legacy\n[labinf_default]\nactivate = 1\n[labinf_legacy]\nactivate = 1\n"
Path('/etc/ssl/openssl-lab.cnf').write_text(s)
PYCONF
ENV OPENSSL_CONF=/etc/ssl/openssl-lab.cnf

WORKDIR /home/kali
USER kali
ENTRYPOINT ["/usr/local/bin/labinf-node-init.sh"]
CMD ["sleep", "infinity"]
