FROM httpd:2.4

COPY ./public-html/ /usr/local/apache2/htdocs/
RUN  chown -R www-data:www-data /usr/local/apache2/htdocs/

# Install Exim4
RUN apt-get update && apt-get install -y exim4 netcat-traditional
RUN useradd --create-home alice

# Copy Exim4 configuration
COPY conf/update-exim4.conf.conf /etc/exim4/update-exim4.conf.conf
COPY conf/exim4 /etc/default/exim4 
COPY conf/config.autogenerated /var/lib/exim4/config.autogenerated

# Copy Python script
COPY scripts/ /usr/local/bin/

# Install Python dependencies
RUN apt-get install -y python3

# Expose ports
EXPOSE 80 25 1337 2121

# Start services
CMD ["bash", "/usr/local/bin/start.sh"]